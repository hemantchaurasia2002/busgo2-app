// Prisma Schema — BusGO 2.0
// Provider: PostgreSQL
// Auth: Better Auth (email/password)
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// AUTH MODELS  (required by Better Auth — do not rename fields)
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  sessions      Session[]
  accounts      Account[]
  bookings      Booking[]
}

/// Better Auth session table
model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
}

/// Better Auth account table — stores hashed password for email/password provider
model Account {
  id                    String    @id @default(cuid())
  accountId             String    // provider-specific user id
  providerId            String    // e.g. "credential", "google"
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?   // bcrypt hash (email/password login)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                String

  @@unique([providerId, accountId])
}

/// Better Auth email verification / password-reset tokens
model Verification {
  id         String   @id @default(cuid())
  identifier String   // email address being verified
  value      String   // the token value
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// APP MODELS
// ─────────────────────────────────────────────────────────────────────────────

/// A bus route from one city to another with schedule and pricing
model Route {
  id          String   @id @default(cuid())
  origin      String
  destination String
  departureAt DateTime
  arrivalAt   DateTime
  price       Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // A route can have many buses (e.g. daily departures)
  buses       Bus[]
}

/// A physical bus assigned to a route
model Bus {
  id           String   @id @default(cuid())
  name         String   // e.g. "Volvo A/C Sleeper"
  number       String   @unique // registration number
  totalSeats   Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // A Bus belongs to one Route
  route        Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  routeId      String

  // A Bus has many Seats
  seats        Seat[]
}

/// An individual seat on a Bus
model Seat {
  id         String   @id @default(cuid())
  seatNumber String   // e.g. "1A", "12B"
  isBooked   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // A Seat belongs to one Bus
  bus        Bus      @relation(fields: [busId], references: [id], onDelete: Cascade)
  busId      String

  // A Seat can have at most one active Booking
  booking    Booking?

  @@unique([busId, seatNumber])
}

/// A booking links a User to a specific Seat
model Booking {
  id          String        @id @default(cuid())
  bookingDate DateTime      @default(now())
  status      BookingStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // A Booking belongs to one User
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String

  // A Booking is for exactly one Seat
  seat        Seat          @relation(fields: [seatId], references: [id], onDelete: Cascade)
  seatId      String        @unique // enforces one booking per seat at a time
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}
